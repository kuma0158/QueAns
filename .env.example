# === 本番 (Docker / Xserver VPS) で必要 ===

# 取得するドメイン (Caddy が自動で Let's Encrypt 証明書を発行)
DOMAIN=queans.example.com

# Let's Encrypt 通知メール
LETSENCRYPT_EMAIL=you@example.com

# Cookie セッション署名鍵 (32バイト hex 推奨)
# Linux/Mac: openssl rand -hex 32
# Windows PowerShell: -join ((1..32) | %{ "{0:x2}" -f (Get-Random -Max 256) })
SESSION_SECRET=replace-me-with-random-hex

# 初回起動時の初期パスワード (seed.ts が読む。設定しなければ admin123/user123)
SEED_ADMIN_PASSWORD=set-strong-password
SEED_USER_PASSWORD=set-strong-password

# === ローカル開発 (npm run dev) で必要 ===
# DATABASE_URL=file:./dev.db
